{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "inputs": [
        "...",
        "."
      ],
      "commands": [
        "python -m venv --clear .venv",
        ".venv/bin/python -m pip install --no-cache-dir -r requirements.txt",
        ".venv/bin/python -c \"import pydantic, fastapi, uvicorn; import artboard_engine.api\""
      ]
    }
  },
  "deploy": {
    "startCommand": ".venv/bin/python -m artboard_engine.server",
    "variables": {
      "ARTBOARD_HOST": "0.0.0.0"
    },
    "aptPackages": [
      "...",
      "tesseract-ocr",
      "tesseract-ocr-eng",
      "ghostscript"
    ]
  }
}
